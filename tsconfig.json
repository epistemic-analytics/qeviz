{
  "compilerOptions": {
    "outDir": "./dist/",
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "declaration": true,
    "lib": ["dom", "dom.iterable", "ES2020"],
    "baseUrl": "./",
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
